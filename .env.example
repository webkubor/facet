# 复制为 .env 后填入真实信息（.env 已被 .gitignore 屏蔽，不会入库）。
# front matter 中任意值都可以写 ${VAR} 或 ${VAR:-默认值} 引用这里的变量。

# ===== 简历模板用 =====
RESUME_CONTACT=you@example.com / +86 138-0000-0000
RESUME_LINKS=github.com/yourname / yoursite.com

# ===== 站点 =====
SITE_DOMAIN=share.webkubor.online

# ===== 加密交付 =====
# 受保护文档的访问密码（线上用 secret 设置，见 docs/encrypted-delivery.md）
DEFAULT_PASSWORD=your-access-password

# 访问日志页的 admin token
ADMIN_TOKEN=your-admin-token

# ===== 发布通知 webhook（im-notify-kit）=====
# 飞书群机器人 webhook：群设置 → 群机器人 → 添加自定义机器人 → 复制 webhook 地址
FEISHU_WEBHOOK=

# 企业微信群机器人 webhook：群设置 → 群机器人 → 添加 → 复制 webhook 地址
WECOM_WEBHOOK=

{
  "name": "knowledge-pdf-kit",
  "version": "0.2.0",
  "description": "Generate polished knowledge tutorial PDFs and shareable long images from Markdown with reusable content flow templates.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "keywords": [
    "markdown-to-pdf",
    "html-to-pdf",
    "knowledge-pdf",
    "tutorial-pdf",
    "resume-pdf",
    "cv-template",
    "long-image",
    "morandi",
    "editorial-design",
    "research-report",
    "strategy-brief",
    "gallery-catalog",
    "xiaohongshu",
    "wechat",
    "playwright",
    "typescript",
    "agent-ready"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/knowledge-pdf-kit.git"
  },
  "bugs": {
    "url": "https://github.com/webkubor/knowledge-pdf-kit/issues"
  },
  "homepage": "https://github.com/webkubor/knowledge-pdf-kit#readme",
  "scripts": {
    "build": "tsx src/build.ts",
    "build:example": "tsx src/build.ts --input content/example.md --template warm-handbook --output output/example-warm-handbook.pdf",
    "build:all": "tsx src/build.ts --input content/example.md --all",
    "build:talk": "tsx src/build.ts --input content/ai-readable-kit.md --talk --theme themes/scorecard-blue.json --output output/ai-readable-kit.talk.html",
    "talk:dev": "bunx vite output --port 4173 --host --open /ai-readable-kit.talk.html",
    "build:resume": "tsx src/build.ts --input content/resume-example.md --template resume-payment-lead --output output/resume-example.pdf",
    "build:resume:all": "tsx src/build.ts --input content/resume-example.md --all",
    "setup:browsers": "playwright install chromium",
    "check": "tsc --noEmit",
    "verify:resume": "node scripts/verify-resume.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^15.0.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.19"
  }
}
